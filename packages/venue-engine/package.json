{
  "name": "@smart-crowd-navigator/venue-engine",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:perf": "node ./scripts/run-perf-tests.mjs",
    "test:perf:update-baselines": "node ./scripts/run-perf-tests.mjs --update-baselines",
    "coverage": "vitest run --coverage",
    "lint": "biome check src"
  }
}
